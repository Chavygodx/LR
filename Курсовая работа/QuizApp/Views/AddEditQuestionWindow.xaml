<Window x:Class="QuizApp.Views.AddEditQuestionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вопрос" Height="400" Width="500"
        WindowStartupLocation="CenterOwner" WindowStyle="ToolWindow">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Краткое название (для отображения в списке) -->
        <StackPanel>
            <TextBlock Text="Краткое название (для списка):" FontWeight="Bold"/>
            <TextBox x:Name="QuestionNameTextBox" Margin="0,0,0,10" Padding="3"/>
        </StackPanel>

        <!-- Текст вопроса -->
        <StackPanel Grid.Row="1">
            <TextBlock Text="Текст вопроса:" FontWeight="Bold"/>
            <TextBox x:Name="QuestionTextTextBox" Margin="0,0,0,10" Padding="3" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="60"/>
        </StackPanel>

        <!-- Варианты ответов -->
        <GroupBox Grid.Row="2" Header="Варианты ответов" Margin="0,5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ListBox x:Name="OptionsListBox" DisplayMemberPath="Text" 
                         SelectionChanged="OptionsListBox_SelectionChanged"/>

                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5">
                    <Button Content="Добавить вариант" Click="AddOption_Click" Margin="0,0,5,0" Padding="10,2"/>
                    <Button Content="Изменить вариант" x:Name="EditOptionButton" 
                            IsEnabled="False" Click="EditOption_Click" Margin="0,0,5,0" Padding="10,2"/>
                    <Button Content="Удалить вариант" x:Name="DeleteOptionButton" 
                            IsEnabled="False" Click="DeleteOption_Click" Padding="10,2"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- Выбор правильного ответа -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,10,0,0">
            <TextBlock Text="Правильный ответ:" FontWeight="Bold" VerticalAlignment="Center"/>
            <ComboBox x:Name="CorrectOptionComboBox" Width="200" Margin="10,0" DisplayMemberPath="Text" 
                      SelectionChanged="CorrectOptionComboBox_SelectionChanged"/>
        </StackPanel>

        <!-- Кнопки ОК/Отмена -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="OK" Click="OK_Click" Margin="0,0,10,0" Padding="20,5" IsDefault="True"/>
            <Button Content="Отмена" Click="Cancel_Click" Padding="20,5" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>