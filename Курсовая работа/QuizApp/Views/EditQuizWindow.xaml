<Window x:Class="QuizApp.Views.EditQuizWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактирование викторины" Height="450" Width="600"
        WindowStartupLocation="CenterOwner" WindowStyle="ToolWindow">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Название викторины -->
        <StackPanel>
            <TextBlock Text="Название викторины:" FontWeight="Bold"/>
            <TextBox x:Name="QuizNameTextBox" Margin="0,0,0,10" Padding="3"/>
        </StackPanel>

        <!-- Список вопросов -->
        <GroupBox Grid.Row="1" Header="Вопросы" Margin="0,5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ListBox x:Name="QuestionsListBox" DisplayMemberPath="Name" 
                         SelectionChanged="QuestionsListBox_SelectionChanged"/>

                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5">
                    <Button Content="Добавить" Click="AddQuestion_Click" Margin="0,0,5,0" Padding="10,2"/>
                    <Button Content="Изменить" x:Name="EditQuestionButton" 
                            IsEnabled="False" Click="EditQuestion_Click" Margin="0,0,5,0" Padding="10,2"/>
                    <Button Content="Удалить" x:Name="DeleteQuestionButton" 
                            IsEnabled="False" Click="DeleteQuestion_Click" Padding="10,2"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- Кнопки сохранения/отмены -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Сохранить" Click="Save_Click" Margin="0,0,10,0" Padding="20,5" IsDefault="True"/>
            <Button Content="Отмена" Click="Cancel_Click" Padding="20,5" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>