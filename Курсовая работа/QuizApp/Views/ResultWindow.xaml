<Window x:Class="QuizApp.Views.ResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Результаты" Height="200" Width="300"
        WindowStartupLocation="CenterOwner" WindowStyle="ToolWindow" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Викторина завершена!" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <TextBlock Grid.Row="1" Text="Правильных ответов:" HorizontalAlignment="Left"/>
        <TextBlock Grid.Row="1" x:Name="CorrectCountText" FontWeight="Bold" HorizontalAlignment="Right"/>

        <TextBlock Grid.Row="2" Text="Неправильных ответов:" HorizontalAlignment="Left" Margin="0,5,0,0"/>
        <TextBlock Grid.Row="2" x:Name="WrongCountText" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,5,0,0"/>

        <Button Grid.Row="3" Content="Закрыть" Click="CloseButton_Click" Width="100" Height="30" HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
    </Grid>
</Window>