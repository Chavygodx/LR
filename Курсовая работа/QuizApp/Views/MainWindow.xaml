<Window x:Class="QuizApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Викторины" Height="450" Width="800"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Левая панель: список викторин -->
        <ListBox x:Name="QuizzesListBox" DisplayMemberPath="Name" 
                 SelectionChanged="QuizzesListBox_SelectionChanged"/>

        <!-- Правая панель: информация и кнопки -->
        <StackPanel Grid.Column="1" Margin="10,0,0,0">
            <TextBlock Text="Название:" FontWeight="Bold"/>
            <TextBlock x:Name="QuizNameText" Margin="0,0,0,10"/>

            <TextBlock Text="Количество вопросов:" FontWeight="Bold"/>
            <TextBlock x:Name="QuestionsCountText" Margin="0,0,0,10"/>

            <Button Content="Пройти викторину" x:Name="PassButton" 
                    IsEnabled="False" Click="PassButton_Click" Margin="0,0,0,5" Padding="10,5"/>
            <Button Content="Создать новую викторину" Click="CreateQuiz_Click" Margin="0,0,0,5" Padding="10,5"/>
            <Button Content="Редактировать викторину" x:Name="EditButton" 
                    IsEnabled="False" Click="EditQuiz_Click" Margin="0,0,0,5" Padding="10,5"/>
            <Button Content="Удалить викторину" x:Name="DeleteButton" 
                    IsEnabled="False" Click="DeleteQuiz_Click" Margin="0,0,0,5" Padding="10,5"/>
        </StackPanel>
    </Grid>
</Window>